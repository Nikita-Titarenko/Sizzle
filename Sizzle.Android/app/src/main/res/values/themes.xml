<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the UI; this theme only covers the window and AppCompat (per-app language). -->
    <style name="Theme.Sizzle" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Sizzle.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Sizzle</item>
    </style>
</resources>
