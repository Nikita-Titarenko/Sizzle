<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sizzle.Application\Sizzle.Application.csproj" />
    <ProjectReference Include="..\Sizzle.Domain\Sizzle.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="InitialData\ingredients*.json" WithCulture="false" />
    <EmbeddedResource Include="InitialData\ingredient-unit.json" WithCulture="false" />
    <EmbeddedResource Include="InitialData\categories*.json" WithCulture="false" />
    <EmbeddedResource Include="TestData\*.json" WithCulture="false" />
    <EmbeddedResource Include="TestData\recipes-media\*" WithCulture="false" />
    <EmbeddedResource Include="TestData\recipe-steps-media\*" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />
    <PackageReference Include="Google.Cloud.Storage.V1" Version="5.0.0" />
    <PackageReference Include="Google.GenAI" Version="2.1.0" />
    <PackageReference Include="MailKit" Version="4.12.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Stripe.net" Version="53.1.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.9.32" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
  </ItemGroup>

</Project>
